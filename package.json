{
  "name": "paras-prints-solutions",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"node scripts/start-web.mjs dev\"",
    "build": "npm run build -w frontend",
    "start": "concurrently -k -n api,web \"npm start -w backend\" \"node scripts/start-web.mjs start\"",
    "test": "npm test -w backend && node --test scripts/tests/*.test.mjs",
    "test:env": "node --test scripts/tests/env.test.mjs",
    "test:startup": "node --test scripts/tests/startup.test.mjs",
    "lint": "npm run lint -w frontend",
    "seed": "npm run seed -w backend",
    "verify": "node scripts/verify-site.mjs",
    "assets:profile": "node scripts/create-profile.mjs",
    "assets:review": "node scripts/render-profile.mjs",
    "format": "prettier --write frontend/src backend/src backend/tests scripts documentation README.md"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
